{
  "name": "file-orchestrator",
  "displayName": "File Orchestrator",
  "description": "Efficiently manage related files in your projects. Rename, copy, move, delete files while automatically handling associated files with different extensions. Customizable for various project types and file structures.",
  "version": "0.0.7",
  "publisher": "binghanlin",
  "repository": "https://github.com/BingHanLin/vscode-file-orchestrator",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fileOrchestratorContainer",
          "title": "File Orchestrator",
          "icon": "images/sidebar_icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "file-orchestrator.renameFile",
        "title": "Rename File",
        "category": "File Orchestrator",
        "icon": "$(edit)"
      },
      {
        "command": "file-orchestrator.copyFile",
        "title": "Copy File",
        "category": "File Orchestrator",
        "icon": "$(copy)"
      },
      {
        "command": "file-orchestrator.deleteFile",
        "title": "Delete File",
        "category": "File Orchestrator",
        "icon": "$(trash)"
      },
      {
        "command": "file-orchestrator.moveFile",
        "title": "Move File",
        "category": "File Orchestrator",
        "icon": "$(move)"
      },
      {
        "command": "file-orchestrator.createFile",
        "title": "Create File",
        "category": "File Orchestrator",
        "icon": "$(new-file)"
      },
      {
        "command": "file-orchestrator.jumpToRelatedFile",
        "title": "Jump To Related File",
        "category": "File Orchestrator",
        "icon": "$(link)"
      },
      {
        "command": "file-orchestrator.bulkReplace",
        "title": "String Replace In Related Files",
        "category": "File Orchestrator",
        "icon": "$(find-replace)"
      },
      {
        "command": "file-orchestrator.openAllRelatedFiles",
        "title": "Open All Related Files",
        "category": "File Orchestrator",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "file-orchestrator.setActiveExtensionGroup",
        "title": "Set Active Extension Group",
        "category": "File Orchestrator",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "file-orchestrator.jumpToRelatedFile",
        "key": "alt+p",
        "mac": "alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "File Orchestrator",
      "properties": {
        "fileOrchestrator.defaultExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".cpp",
            ".hpp",
            ".cxx",
            ".hxx",
            ".c",
            ".h"
          ],
          "description": "Default list of file extensions to consider as related files for renaming."
        },
        "fileOrchestrator.customExtensionGroups": {
          "type": "object",
          "default": {
            "Qt-Cpp": [
              ".cpp",
              ".hpp",
              ".cxx",
              ".hxx",
              ".c",
              ".h",
              ".ui"
            ]
          },
          "description": "Custom extension groups for different project types. Each group is a named set of related file extensions, e.g. { 'Qt-Cpp': ['.cpp', '.hpp', ...] }."
        },
        "fileOrchestrator.jumpToRelatedFileShortcut": {
          "type": "string",
          "default": "alt+p",
          "description": "Keyboard shortcut for jumping to related files. Use the format 'ctrl+key', 'shift+key', etc."
        },
        "fileOrchestrator.activeExtensionGroup": {
          "type": "string",
          "default": "default",
          "description": "Choose which extension group to use for file operations: 'default' uses fileOrchestrator.defaultExtensions, or select a key from fileOrchestrator.customExtensionGroups."
        },
        "fileOrchestrator.searchScope": {
          "type": "string",
          "enum": [
            "sameDirectory",
            "workspace",
            "customPaths"
          ],
          "default": "workspace",
          "description": "Where to search for related files: 'sameDirectory' searches only in the same folder, 'workspace' searches the entire workspace, 'customPaths' uses custom directory patterns.",
          "enumDescriptions": [
            "Search only in the same directory as the current file (fastest, original behavior)",
            "Search across the entire workspace (recommended, with smart caching)",
            "Search in custom directory patterns defined in customSearchPaths"
          ]
        },
        "fileOrchestrator.searchMaxDepth": {
          "type": "number",
          "default": 0,
          "description": "Maximum directory depth for searching related files. Set to 0 for unlimited depth. Higher values improve performance in very deep directory structures."
        },
        "fileOrchestrator.searchTimeout": {
          "type": "number",
          "default": 5000,
          "description": "Timeout for file search operations in milliseconds. Prevents freezing on very large projects."
        },
        "fileOrchestrator.searchExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.vscode/**",
            "**/coverage/**"
          ],
          "description": "Glob patterns to exclude from search. These directories will be skipped to improve performance."
        },
        "fileOrchestrator.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "Enable caching of search results for better performance. Cache automatically invalidates when files are created, deleted, or renamed."
        },
        "fileOrchestrator.customSearchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom directory patterns to search when searchScope is set to 'customPaths'. Use glob patterns like 'src/**' or 'components/**'.",
          "examples": [
            [
              "src/**",
              "test/**"
            ]
          ]
        }
      }
    },
    "submenus": [
      {
        "id": "file-orchestrator.submenu",
        "label": "File Orchestrator",
        "icon": "$(file-symlink-directory)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "file-orchestrator.submenu",
          "group": "2_workspace",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "file-orchestrator.submenu": [
        {
          "command": "file-orchestrator.renameFile",
          "group": "1_operations@1",
          "title": "Rename File"
        },
        {
          "command": "file-orchestrator.copyFile",
          "group": "1_operations@2",
          "title": "Copy File"
        },
        {
          "command": "file-orchestrator.moveFile",
          "group": "1_operations@3",
          "title": "Move File"
        },
        {
          "command": "file-orchestrator.deleteFile",
          "group": "1_operations@4",
          "title": "Delete File"
        },
        {
          "command": "file-orchestrator.jumpToRelatedFile",
          "group": "2_navigation@1",
          "title": "Jump To Related File"
        },
        {
          "command": "file-orchestrator.openAllRelatedFiles",
          "group": "2_navigation@2",
          "title": "Open All Related Files"
        },
        {
          "command": "file-orchestrator.bulkReplace",
          "group": "3_advanced@1",
          "title": "String Replace In Related Files"
        }
      ]
    },
    "views": {
      "fileOrchestratorContainer": [
        {
          "id": "fileOrchestrator.relatedFilesView",
          "name": "Related Files"
        },
        {
          "id": "fileOrchestrator.commandsView",
          "name": "Commands"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "license": "MIT"
}